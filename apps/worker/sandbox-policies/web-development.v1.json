{
  "id": "web-development",
  "version": 1,
  "description": "Package registries and static CDNs, read-only. Nothing else.",
  "parameters": [],
  "policy": {
    "version": 1,
    "filesystem": {
      "include_workdir": true,
      "read_only": [
        "/usr",
        "/lib",
        "/bin",
        "/etc",
        "/proc",
        "/dev/urandom",
        "/var/log"
      ],
      "read_write": [
        "/workspace",
        "/tmp",
        "/dev/null"
      ]
    },
    "landlock": {
      "compatibility": "best_effort"
    },
    "process": {
      "run_as_user": "sandbox",
      "run_as_group": "sandbox"
    },
    "network_policies": {
      "package_registries": {
        "name": "package_registries",
        "endpoints": [
          {
            "host": "registry.npmjs.org",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "registry.yarnpkg.com",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "pypi.org",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "files.pythonhosted.org",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          }
        ],
        "binaries": [
          {
            "path": "/usr/local/bin/node"
          },
          {
            "path": "/usr/bin/python3.12"
          }
        ]
      },
      "static_cdns": {
        "name": "static_cdns",
        "endpoints": [
          {
            "host": "cdn.jsdelivr.net",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "unpkg.com",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "cdnjs.cloudflare.com",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "fonts.googleapis.com",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          },
          {
            "host": "fonts.gstatic.com",
            "port": 443,
            "protocol": "rest",
            "enforcement": "NETWORK_ENFORCEMENT_MODE_ENFORCE",
            "access": "NETWORK_ACCESS_PRESET_READ_ONLY"
          }
        ],
        "binaries": [
          {
            "path": "/usr/local/bin/node"
          },
          {
            "path": "/usr/bin/curl"
          },
          {
            "path": "/usr/bin/python3.12"
          }
        ]
      }
    }
  }
}
