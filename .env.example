# .env.example — copy to .env and fill in before `docker compose up`

# When true, REST and WebSocket reject missing credentials instead of
# falling back to the local default tenant. Set on the OVH control plane.
# ORVYN_CLOUD_MODE=true
# ORVYN_ENV=production
# Public origin the desktop and Caddy share. Used for production CORS.
# ORVYN_PUBLIC_URL=https://orvyn.virphoneusa.com
# Staging control plane (separate DB/Redis/artifacts/secrets).
# ORVYN_STAGING_URL=https://staging.orvyn.virphoneusa.com
# STAGING_DOMAIN=staging.orvyn.virphoneusa.com
# ORVYN_REDIS_PREFIX=orvyn:production:
# Desktop production cloud host (default https://orvyn.virphoneusa.com).
# ORVYN_CLOUD_URL=https://orvyn.virphoneusa.com
# Internal Qdrant URL on the control-plane network. Desktop never talks to it.
# ORVYN_QDRANT_URL=http://qdrant:6333
# Internal PostgreSQL role used by the OVH control plane. The deployment
# creates a random value on first install when this is empty and preserves it.
# Generate manually with: openssl rand -hex 32
# ORVYN_PG_PASSWORD=

# Required for any deployment reachable beyond localhost. The OVH deployment
# creates and preserves a random value when this is empty. Generate manually with:
#   openssl rand -hex 32
ORVYN_API_KEY=

# Master key for the server-side credential vault. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Required when ORVYN_ENV=production or ORVYN_CLOUD_MODE=true.
# Never put this in the desktop installer or a tenant database.
# ORVYN_VAULT_KEY=

# Domain pointed at this server's IP (A record), used by Caddy for
# automatic HTTPS. Must be reachable on ports 80 and 443.
DOMAIN=orvyn.yourdomain.com

# OpenAI (or any OpenAI-compatible host). Seeded as gpt-4o-mini when set.
# Never commit the real key — copy this file to .env
MODEL_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CODE_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536

# Cheaper Inference (OpenAI-compatible). Seeded alongside OpenAI when set.
CHEAPER_INFERENCE_API_KEY=
ORVYN_DEFAULT_MODEL_PROVIDER=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com
CHEAPER_INFERENCE_CHAT_MODEL=gpt-5.6-luna
CHEAPER_INFERENCE_CODE_MODEL=gpt-5.6-terra
# Optional extra catalog IDs, comma-separated
CHEAPER_INFERENCE_MODELS=
CHEAPER_INFERENCE_IMAGE_MODEL=nano-banana
CHEAPER_INFERENCE_IMAGE_MODELS=nano-banana-2,gpt-image-2

# Fireworks. When set, ORVYN registers the certified lanes:
# Auto agent: accounts/fireworks/models/deepseek-v4p1-flash (1.04M)
# Code/Server/Deploy: accounts/fireworks/models/glm-5p3
# Frontend: accounts/fireworks/models/kimi-k2p7-code
# Images: flux-kontext-pro and flux-kontext-max
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference
# Comma-separated Fireworks Deploy on Demand ids that are live on this account.
# Example: accounts/fireworks/models/qwen3-vl-30b-a3b-instruct
FIREWORKS_VISION_MODELS=

# Local Ollama. When OLLAMA_MODEL is set, chat/code/agent route here
# instead of OpenAI. Pull first: ollama pull qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Production Cloud (OVH + desktop client): set the CI key so chat/code/image
# roles are real models, not orvyn-mock. ORION_MODEL_ID must match a
# registered id (example: ci:gpt-5.6-terra).
# ORION_MODEL_ID=ci:gpt-5.6-terra
# CHEAPER_INFERENCE_CHAT_MODEL=gpt-5.6-luna
# CHEAPER_INFERENCE_CODE_MODEL=gpt-5.6-terra
# CHEAPER_INFERENCE_IMAGE_MODEL=nano-banana

# Astra/ORION orchestrator model. ORION is a ROLE, not a model SKU — this must be
# the id of a registered model (e.g. ci:gpt-5.6-terra, gpt-4o). It routes the
# planner + reviewer tasks. ORCHESTRATOR_MODEL is accepted as an alias.
ORION_MODEL_ID=
ASTRA_MODEL_ID=

# DeepSeek coding worker. When set, deepseek-v4-flash/-pro are registered
# (OpenAI-compatible wire) and the executor role defaults to flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CODE_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Official MCP Registry is public. Glama federation needs a directory key.
# Store the live value in gitignored .env or mcp.secret.glama — never commit it.
# GLAMA_API_KEY=
# SMITHERY_API_KEY=

# --- Local persistence ---
# Where per-tenant SQLite databases live (missions, usage, settings, models).
# Default: ~/.orvyn/data
# ORVYN_DATA_DIR=

# --- Abuse protection (all active; sensible defaults, 0 disables) ---
# Per-tenant API rate limit, requests/minute (default 300).
# ORVYN_RATE_LIMIT_RPM=300
# Per-IP limit on the unauthenticated /auth routes (default 30).
# ORVYN_AUTH_RATE_LIMIT_RPM=30
# Monthly model-request quota per tenant; counted from persisted usage
# events, so restarts don't reset the budget (default 0 = unlimited).
# ORVYN_QUOTA_MODEL_REQUESTS_MONTH=0
# Monthly mission quota per tenant (default 0 = unlimited).
# ORVYN_QUOTA_MISSIONS_MONTH=0
# Concurrent missions per tenant; extra missions queue FIFO (default 2).
# ORVYN_MAX_CONCURRENT_MISSIONS=2

# --- Reserved for the cloud tier (designed, NOT yet consumed by code) ---
# See docs/CLOUD_ARCHITECTURE.md and docs/BILLING.md before setting these.
# DATABASE_URL=
# REDIS_URL=
# ORVYN_API_URL=
# JWT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Public origin used in Stripe Checkout success/cancel URLs:
# ORVYN_PUBLIC_ORIGIN=https://orvyn.virphoneusa.com
# Price ids created in Stripe (repository variables on CI; see docs/BILLING.md):
# STRIPE_PRICE_STARTER_MONTHLY=price_...   STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...       STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_POWER_MONTHLY=price_...     STRIPE_PRICE_POWER_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...  STRIPE_PRICE_BUSINESS_ANNUAL=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...      STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_PACK_10K=price_...  STRIPE_PRICE_PACK_25K=price_...  STRIPE_PRICE_PACK_50K=price_...
# STRIPE_PRICE_PACK_100K=price_... STRIPE_PRICE_PACK_250K=price_... STRIPE_PRICE_PACK_500K=price_...
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# --- Runaway guards (0 = unlimited) ---
# Per-run caps for the single-agent loop. A run that hits one stops with a
# clear "Run budget exceeded" error instead of billing forever.
# ORVYN_RUN_MAX_MODEL_REQUESTS=60
# ORVYN_RUN_MAX_TOKENS=2000000
# ORVYN_RUN_MAX_TOOL_CALLS=200
# Per-mission caps for orchestrated missions (Multitask). A mission that hits
# one is set to BLOCKED for a human decision.
# ORVYN_MISSION_MAX_MODEL_REQUESTS=300
# ORVYN_MISSION_MAX_TOKENS=5000000
# Retry: transient provider failures (429/5xx/network) are retried with
# backoff automatically; nothing to configure unless you want fewer attempts.

# Nebius Token Factory (OpenAI-compatible, global provider). A curated set is
# registered and shown in the model menu (GLM-5.3, GLM-5.3-Flash, Kimi K2.7
# Code, Kimi K3, Qwen3.5-397B, Qwen3-30B-A3B, DeepSeek-V4-Pro, Nemotron 3.5
# Lightning); the rest of the account's catalog is callable and searchable but
# not listed. Routing uses Nebius by role and as the second provider for models
# Fireworks also serves (GLM-5.3, GLM-5.3-Flash, Kimi K2.7 Code).
# Optional: NEBIUS_MODELS=id1,id2 (list more in the menu)  NEBIUS_BASE_URL=
NEBIUS_API_KEY=
# Account email: verification links on signup (SMTP). Without it, signups
# skip email verification. ORVYN_PUBLIC_ORIGIN sets the link host.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Failover: a provider that answers 429/5xx/timeouts is skipped for 60s
# (doubling on repeats, max 15 min); the run continues on the same model
# elsewhere, then an equivalent model, billed at the weight it started on.
# ORVYN_PROVIDER_COOLDOWN_SECONDS=60
# ORVYN_STREAM_RETRY_ATTEMPTS=2
# Embeddings for memory and code search (opt-in; the index is rebuilt for the
# new model in its own vector space):
# ORVYN_EMBED_MODEL=nebius:Qwen/Qwen3-Embedding-8B
# ORVYN_EMBED_DIMS=4096

# ---- Web portals (one backend, routed by host) ----
# Customer portal and the staff Admin Portal. Point both DNS records at this server.
ORVYN_APP_HOST=app.kernelailabs.com
ORVYN_ADMIN_HOST=admin.kernelailabs.com
# Links in emails (verification, password reset) and Stripe returns go to the customer portal.
# ORVYN_PUBLIC_ORIGIN=https://app.kernelailabs.com
# Accounts with these emails become Super Admins when they sign in (comma separated).
ORVYN_SUPER_ADMIN_EMAILS=

# Compatible tenant-data mirror for the current production code line.
# Uses the existing ORVYN_PG_URL. Reads/writes remain SQLite-authoritative.
ORVYN_POSTGRES_MIRROR=0
# Switch BOTH primary flags together only after migration and parity verification.
# Primary mode requires mirror=0 and ORVYN_POSTGRES_READ_FALLBACK_SQLITE=0.
ORVYN_POSTGRES_PRIMARY_READS=0
ORVYN_POSTGRES_PRIMARY_WRITES=0
ORVYN_POSTGRES_READ_FALLBACK_SQLITE=1
# Enable only after frozen desktop-release snapshot import and parity verification.
ORVYN_POSTGRES_DESKTOP_RELEASES=0

# Shared cloud execution/sandbox registry; local desktop remains SQLite.
ORVYN_POSTGRES_EXECUTION=0
