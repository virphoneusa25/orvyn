# .env.example — copy to .env and fill in before `docker compose up`

# Required for any deployment reachable beyond localhost. Generate with:
#   openssl rand -hex 32
ORVYN_API_KEY=

# Domain pointed at this server's IP (A record), used by Caddy for
# automatic HTTPS. Must be reachable on ports 80 and 443.
DOMAIN=orvyn.yourdomain.com

# OpenAI (or any OpenAI-compatible host). Seeded as gpt-4o-mini when set.
# Never commit the real key — copy this file to .env
MODEL_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CODE_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536

# Cheaper Inference (OpenAI-compatible). Seeded alongside OpenAI when set.
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com
CHEAPER_INFERENCE_CHAT_MODEL=gpt-5.6-luna
CHEAPER_INFERENCE_CODE_MODEL=gpt-5.6-terra
# Optional extra catalog IDs, comma-separated
CHEAPER_INFERENCE_MODELS=
CHEAPER_INFERENCE_IMAGE_MODEL=nano-banana
CHEAPER_INFERENCE_IMAGE_MODELS=nano-banana-2,gpt-image-2

# Local Ollama. When OLLAMA_MODEL is set, chat/code/agent route here
# instead of OpenAI. Pull first: ollama pull qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Astra orchestrator model. Astra is a ROLE, not a model SKU — this must be
# the id of a registered model (e.g. gpt-4o, deepseek-v4-pro). It routes the
# planner + reviewer tasks. ORCHESTRATOR_MODEL is accepted as an alias.
ASTRA_MODEL_ID=

# DeepSeek coding worker. When set, deepseek-v4-flash/-pro are registered
# (OpenAI-compatible wire) and the executor role defaults to flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CODE_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# --- Local persistence ---
# Where per-tenant SQLite databases live (missions, usage, settings, models).
# Default: ~/.orvyn/data
# ORVYN_DATA_DIR=

# --- Abuse protection (all active; sensible defaults, 0 disables) ---
# Per-tenant API rate limit, requests/minute (default 300).
# ORVYN_RATE_LIMIT_RPM=300
# Per-IP limit on the unauthenticated /auth routes (default 30).
# ORVYN_AUTH_RATE_LIMIT_RPM=30
# Monthly model-request quota per tenant; counted from persisted usage
# events, so restarts don't reset the budget (default 0 = unlimited).
# ORVYN_QUOTA_MODEL_REQUESTS_MONTH=0
# Monthly mission quota per tenant (default 0 = unlimited).
# ORVYN_QUOTA_MISSIONS_MONTH=0
# Concurrent missions per tenant; extra missions queue FIFO (default 2).
# ORVYN_MAX_CONCURRENT_MISSIONS=2

# --- Reserved for the cloud tier (designed, NOT yet consumed by code) ---
# See docs/CLOUD_ARCHITECTURE.md and docs/BILLING.md before setting these.
# DATABASE_URL=
# REDIS_URL=
# ORVYN_API_URL=
# JWT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# --- Runaway guards (0 = unlimited) ---
# Per-run caps for the single-agent loop. A run that hits one stops with a
# clear "Run budget exceeded" error instead of billing forever.
# ORVYN_RUN_MAX_MODEL_REQUESTS=60
# ORVYN_RUN_MAX_TOKENS=2000000
# ORVYN_RUN_MAX_TOOL_CALLS=200
# Per-mission caps for orchestrated missions (Multitask). A mission that hits
# one is set to BLOCKED for a human decision.
# ORVYN_MISSION_MAX_MODEL_REQUESTS=300
# ORVYN_MISSION_MAX_TOKENS=5000000
# Retry: transient provider failures (429/5xx/network) are retried with
# backoff automatically; nothing to configure unless you want fewer attempts.
