# infrastructure/docker/Caddyfile
# Caddy auto-provisions and renews a Let's Encrypt cert for {$DOMAIN} as
# long as DNS points at this server and ports 80/443 are reachable.

{$DOMAIN} {
	# REST API + WebSocket both proxy to the backend container.
	# Caddy handles the WebSocket Upgrade header automatically with reverse_proxy.
	reverse_proxy backend:4570

	encode gzip

	log {
		output stdout
		format console
	}
}

# Fallback hostname used before the registrar A record existed.
staging.orvyn.40.160.11.123.sslip.io {
	reverse_proxy backend-staging:4570
	encode gzip
}

# Canonical staging hostname. DNS A record → 40.160.11.123; Caddy holds the LE cert.
{$STAGING_DOMAIN:staging.orvyn.virphoneusa.com} {
	reverse_proxy backend-staging:4570
	encode gzip
}
