# infrastructure/docker/Caddyfile
# Caddy auto-provisions and renews a Let's Encrypt cert for {$DOMAIN} as
# long as DNS points at this server and ports 80/443 are reachable. Compose
# supplies the production hostname when DOMAIN is absent from .env.

{$DOMAIN} {
	# REST API + WebSocket both proxy to the backend container.
	# Caddy handles the WebSocket Upgrade header automatically with reverse_proxy.
	reverse_proxy backend:4570

	encode gzip

	log {
		output stdout
		format console
	}
}

# ORVYN Cloud (customers) and the Admin Portal (staff): the same backend; it
# serves the portal or the admin app by host. Certificates are issued once
# the DNS records point here.
{$ORVYN_APP_HOST:app.kernelailabs.com} {
	reverse_proxy backend:4570
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

{$ORVYN_ADMIN_HOST:admin.kernelailabs.com} {
	reverse_proxy backend:4570
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Robots-Tag "noindex, nofollow"
}

# Fallback hostname used before the registrar A record existed.
staging.orvyn.40.160.11.123.sslip.io {
	reverse_proxy backend-staging:4570
	encode gzip
}

# Canonical staging hostname. DNS A record → 40.160.11.123; Caddy holds the LE cert.
{$STAGING_DOMAIN:staging.orvyn.virphoneusa.com} {
	reverse_proxy backend-staging:4570
	encode gzip
}

# Optional desktop feed. Publish immutable artifacts before atomically replacing latest.yml.
updates.kernelailabs.com {
    root * /srv/orvyn-updates
    @manifest path *.yml
    header @manifest Cache-Control "no-store"
    header X-Content-Type-Options "nosniff"
    file_server
}
