#!/bin/bash
# Dock and rail launcher. Firefox, terminal, files, and VS Code.
app="${1:-}"
shift || true
case "$app" in
  browser|chromium)
    url="${1:-file:///usr/share/orvyn/home.html}"
    if command -v chromium >/dev/null 2>&1; then
      exec chromium --no-sandbox --disable-dev-shm-usage --no-first-run --start-maximized "$url"
    fi
    # One fixed profile per session with ORVYN's resource prefs pre-seeded:
    # a capped frame rate and a single content process keep an animated page
    # from burning the container's CPU budget (measured ~180% before).
    profdir=/profile
    if [ ! -d "$profdir" ]; then
      firefox-esr --CreateProfile "orvyn $profdir" >/dev/null 2>&1 || true
    fi
    if [ -d "$profdir" ]; then
      cp -f /usr/share/orvyn/firefox-user.js "$profdir/user.js" 2>/dev/null || true
      exec firefox-esr -P orvyn --new-window "$url"
    fi
    exec firefox-esr --new-window "$url"
    ;;
  code|editor)
    if command -v code >/dev/null 2>&1; then
      exec code --no-sandbox --disable-gpu /workspace
    fi
    exec geany /workspace
    ;;
  terminal)
    exec lxterminal --working-directory=/workspace
    ;;
  files)
    exec thunar /workspace
    ;;
  apps)
    exec jgmenu_run
    ;;
  *)
    echo "unknown app: $app" >&2
    exit 1
    ;;
esac
