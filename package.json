{
  "name": "viride",
  "version": "0.1.0",
  "private": true,
  "description": "VirIDE — Your Code. Your Models. Your AI.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "npm run dev -w apps/backend",
    "desktop:dev": "npm run dev -w apps/desktop",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
