{
  "name": "orvyn",
  "version": "0.1.0",
  "private": true,
  "description": "ORVYN \u2014 Your Code. Your Models. Your AI.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @orvyn/ai-core",
    "backend:dev": "npm run dev -w apps/backend",
    "desktop:dev": "npm run dev -w apps/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/test/run-tests.mjs",
    "smoke:agent": "npm run build -w @orvyn/backend && node scripts/smoke-agent.mjs",
    "accept:phase1": "npm run build -w @orvyn/backend && node --experimental-strip-types --no-warnings scripts/acceptance/phase1-chat-loop.mjs",
    "accept:phase2": "npm run build -w @orvyn/backend && node scripts/acceptance/phase2-agent-loop.mjs",
    "accept:phase3": "npm run build -w @orvyn/backend && node scripts/acceptance/phase3-execution-target.mjs",
    "accept:phase4": "npm run build -w @orvyn/backend && node scripts/acceptance/phase4-services.mjs",
    "accept:envelope": "npm run build -w @orvyn/backend && node scripts/acceptance/envelope-hello.mjs",
    "accept:turns": "npm run build -w @orvyn/backend && node scripts/acceptance/agent-turns.mjs",
    "accept:verify": "npm run build -w @orvyn/backend && node scripts/acceptance/verification.mjs",
    "accept:browser": "npm run build -w @orvyn/backend && npm run build -w @orvyn/desktop && xvfb-run -a -s \"-screen 0 1600x1000x24\" node scripts/acceptance/browser-session.mjs",
    "accept:local-worker": "npm run build -w @orvyn/backend && node scripts/acceptance/local-worker-reconnect.mjs",
    "accept:admin": "npm run build -w @orvyn/backend && npm run build -w @orvyn/web && node scripts/acceptance/admin-api.mjs && node scripts/acceptance/admin-portal.mjs",
    "accept:portal": "npm run build -w @orvyn/backend && npm run build -w @orvyn/web && node scripts/acceptance/cloud-portal.mjs",
    "accept:web-responsive": "node scripts/acceptance/web-responsive.mjs",
    "accept:chat-live": "npm run build -w @orvyn/backend && node --experimental-strip-types --no-warnings scripts/acceptance/chat-live.mjs",
    "test:list": "node scripts/test/run-tests.mjs --list",
    "test:all": "node scripts/test/run-tests.mjs --all",
    "test:ci": "node scripts/test/run-tests.mjs --json=reports/test-report.json",
    "test:integration": "node scripts/test/run-tests.mjs --tier=integration",
    "test:browser": "node scripts/test/run-tests.mjs --tier=browser",
    "test:network": "node scripts/test/run-tests.mjs --tier=network"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "qs": "6.16.0"
  }
}
